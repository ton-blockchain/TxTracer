{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/lib",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/shared/**/*", "src/features/sandbox/**/*", "src/lib/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/main.ts",
    "src/pages/**/*",
    "src/app/**/*",
    "src/features/godbolt/**/*"
  ]
}
